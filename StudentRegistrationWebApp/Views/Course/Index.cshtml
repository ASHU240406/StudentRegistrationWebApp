@model IEnumerable<StudentRegistrationWebApp.Models.Course>

<a asp-action="Create">Create Course</a>
<h3 class="text-primary">List of Courses</h3>
<hr />
<div class="row">
    <div class="col-md-6">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Course Name</th>
                    <th>Duration (months)</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td>@c.CourseName</td>
                        <td>@c.CourseDuration</td>
                        <td>
                            <a asp-action="Details" asp-route-id="@c.CourseId">View Details</a> |
                            <a asp-action="Edit" asp-route-id="@c.CourseId">Edit</a> |
                            <a asp-action="Delete" asp-route-id="@c.CourseId"
                               onclick="return confirm('Do you wish to delete this course?');">
                                Delete
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
