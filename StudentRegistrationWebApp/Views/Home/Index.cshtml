@{
    ViewData["Title"] = "Home Page";
}

@if (User.Identity!.IsAuthenticated)
{
    <div class="welcome-banner">
        <h2>👋 Welcome back, @User.Identity.Name!</h2>
        <p class="mb-0">
            @if (User.IsInRole("Admin"))
            {
                <span>You're logged in as an <strong>Administrator</strong>. Manage courses and view enrolled students from the menu above.</span>
            }
            else if (User.IsInRole("Student"))
            {
                <span>You're logged in as a <strong>Student</strong>. Browse available courses and register whenever you're ready.</span>
            }
        </p>
    </div>
}
else
{
    <div class="welcome-banner welcome-banner-guest">
        <h2>🎓 Welcome to Student Registration</h2>
        <p class="mb-0">
            Browse our available courses, or
            <a asp-area="Identity" asp-page="/Account/Register" class="text-white text-decoration-underline">register</a>
            /
            <a asp-area="Identity" asp-page="/Account/Login" class="text-white text-decoration-underline">log in</a>
            to get started.
        </p>
    </div>
}

<div class="text-center">
    <h1 class="display-4">Welcome</h1>
    <p>Learn about <a href="https://learn.microsoft.com/aspnet/core">building Web apps with ASP.NET Core</a>.</p>
</div>